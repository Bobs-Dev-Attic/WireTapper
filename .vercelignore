# Keep the serverless bundle small — none of these are needed at runtime.
tests/
.github/
images/
scripts/
docs/
*.md
!requirements.txt
# Exclude pyproject.toml: it only holds ruff/pytest config (no [project] table),
# and Vercel's uv-based Python builder tries to `uv lock` against it and fails.
# Without it, the builder installs from requirements.txt as intended.
pyproject.toml
.env
.env.*
__pycache__/
.ruff_cache/
.pytest_cache/
