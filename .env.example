# WireTapper configuration — copy to `.env` and fill in real values.
# `app.py` auto-loads `.env` when python-dotenv is installed; otherwise export
# these in your shell. NEVER commit your real `.env` (it is git-ignored).
# Full reference: docs/CONFIGURATION.md

# ─── Provider API keys ───────────────────────────────────────────────────────
# See docs/INSTALL.md for how to obtain each. wpa-sec needs no key.
WIGLE_API_NAME=
WIGLE_API_TOKEN=
OPENCELLID_API_KEY=
SHODAN_API_KEY=

# ─── Server (SEC-01) — safe defaults; override for LOCAL DEV only ────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=8080
FLASK_DEBUG=0

# ─── Access control & rate limiting (SEC-03) ────────────────────────────────
# When set, data endpoints require this token via the `X-API-Key` header
# (or `?access_token=`). Leave unset ONLY for localhost/demo use.
WIRETAPPER_ACCESS_TOKEN=
# Default per-IP rate limit for data endpoints.
RATE_LIMIT_DEFAULT=240 per hour
# Rate-limit backend. Default is in-process memory (fine for a single process).
# On serverless / multiple workers use a shared store, e.g.:
#   RATE_LIMIT_STORAGE=redis://default:<pw>@<host>:<port>
# (also install a Redis client: pip install "limits[redis]") — see docs/DEPLOY.md
RATE_LIMIT_STORAGE=memory://

# ─── HTTP client (SEC-07) ────────────────────────────────────────────────────
HTTP_CONNECT_TIMEOUT=3.05
HTTP_READ_TIMEOUT=10
# Max length of a user-supplied /searchzz query before it reaches an upstream.
MAX_QUERY_LEN=256

# ─── Response hardening (SEC-08) — leave ON unless you have a reason ─────────
SECURITY_HEADERS=1
CSP_ENABLED=1

# ─── Logging ─────────────────────────────────────────────────────────────────
# Python log level: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
