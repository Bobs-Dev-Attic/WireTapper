# Copy to `.env` and fill in real values (never commit your real `.env`).
# app.py auto-loads this file when python-dotenv is installed; otherwise export
# the variables in your shell.

# --- Provider API keys ---
WIGLE_API_NAME=
WIGLE_API_TOKEN=
OPENCELLID_API_KEY=
SHODAN_API_KEY=

# --- Server (SEC-01) — safe defaults; override for local dev only ---
FLASK_HOST=127.0.0.1
FLASK_PORT=8080
FLASK_DEBUG=0

# --- Access control (SEC-03) ---
# When set, data endpoints require this token via the `X-API-Key` header
# (or `?access_token=`). Leave unset only for localhost/demo use.
WIRETAPPER_ACCESS_TOKEN=
# Default per-IP rate limit for data endpoints.
RATE_LIMIT_DEFAULT=240 per hour

# --- HTTP client (SEC-07) ---
HTTP_CONNECT_TIMEOUT=3.05
HTTP_READ_TIMEOUT=10
MAX_QUERY_LEN=256
