# Copy to `.env` and fill in real values, OR export these in your shell.
# NOTE: as of this commit the app does NOT auto-load `.env` (no python-dotenv /
# load_dotenv). Until that is added (see TODO.md P1), you must `export` these
# vars in your shell for app-env.py to see them. Never commit your real `.env`.

WIGLE_API_NAME=
WIGLE_API_TOKEN=
OPENCELLID_API_KEY=
SHODAN_API_KEY=
